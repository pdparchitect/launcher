{
  "id": "4398d440-4e4f-4137-b25e-303bfeb2a276",
  "slug": "buzznode",
  "name": "Buzznode",
  "publisher": "PDP Architect",
  "description": "A persistent browser-accessible Linux desktop for one Buzz agent, with terminal, filesystem, browser, and Codex, Claude Code, or Goose runtime support.",
  "tags": [
    "DEVELOPMENT",
    "TERMINAL",
    "AUTONOMOUS"
  ],
  "media": {
    "icon": "buzznode/icon.png",
    "cover": "buzznode/screenshot.png",
    "screenshots": [
      {
        "source": "buzznode/screenshot.png",
        "alt": "Fresh Buzznode desktop with its agent enrollment terminal"
      }
    ]
  },
  "image": "ghcr.io/pdparchitect/buzznode:latest",
  "containerPort": 6901,
  "memory": "4g",
  "sharedMemory": "1g",
  "resolutionEnvironment": "BUZZNODE_RESOLUTION",
  "resolution": "1920x1080",
  "environment": {
    "BUZZNODE_VNC_STATS": "false"
  },
  "mounts": [
    {
      "name": "workspace",
      "target": "/workspace"
    },
    {
      "name": "private/config",
      "target": "/home/buzznode/.config"
    },
    {
      "name": "private/data",
      "target": "/home/buzznode/.local/share"
    },
    {
      "name": "private/buzz",
      "target": "/home/buzznode/.buzz"
    },
    {
      "name": "private/codex",
      "target": "/home/buzznode/.codex"
    },
    {
      "name": "private/claude",
      "target": "/home/buzznode/.claude"
    }
  ]
}
