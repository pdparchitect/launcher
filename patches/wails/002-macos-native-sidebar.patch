@@ -0,0 +1,65 @@
+//
+//  WailsSidebar.h
+//
+//  A native translucent sidebar layered on top of the webview. The webview
+//  keeps the full content rect, so the panel blurs whatever the page draws
+//  underneath it.
+//
+//  On macOS 26 the backdrop is a real NSGlassEffectView (Liquid Glass); older
+//  systems fall back to an NSVisualEffectView with the sidebar material.
+//
+//  Driven entirely from JavaScript, so no Go-side options are involved:
+//
+//    window.webkit.messageHandlers.external.postMessage(
+//      "sidebar:" + JSON.stringify({
+//        width: 250,
+//        inset: 8,                // floats the panel inside the window
+//        cornerRadius: 14,
+//        windowCornerRadius: 26,  // Tahoe toolbar-window shape
+//        topInset: 44,            // clearance for the traffic lights
+//        trafficLightX: 22,       // OPTIONAL. Omit to leave the traffic
+//        trafficLightY: 26,       // lights where AppKit puts them.
+//        material: "glass",       // or "vibrancy" to force the fallback
+//        selected: "home",
+//        items: [
+//          {id: "home", title: "Home", symbol: "house"},
+//          {group: "Library"},
+//          {id: "movies", title: "Movies", symbol: "film"}
+//        ]
+//      })
+//    )
+//
+//  Selecting a row dispatches a DOM event back into the page:
+//
+//    window.addEventListener("wails:sidebar", (e) => console.log(e.detail.id))
+//
+
+#ifndef WailsSidebar_h
+#define WailsSidebar_h
+
+#import <Cocoa/Cocoa.h>
+
+@class WailsContext;
+
+@interface WailsSidebar : NSView <NSTableViewDataSource, NSTableViewDelegate>
+
+@property (assign) WailsContext* context;
+@property (retain) NSView* backdrop;
+@property (retain) NSScrollView* scrollView;
+@property (retain) NSTableView* tableView;
+@property (retain) NSArray* items;
+@property CGFloat panelWidth;
+@property CGFloat inset;
+@property CGFloat cornerRadius;
+@property CGFloat topInset;
+@property CGFloat trafficLightX;
+@property CGFloat trafficLightY;
+@property bool placeTrafficLights;
+@property bool suppressSelectionEvent;
+
++ (WailsSidebar*) attachTo:(WailsContext*)context;
+- (void) configureWithJSON:(NSString*)json;
+
+@end
+
+#endif /* WailsSidebar_h */
diff --git a/internal/frontend/desktop/darwin/WailsSidebar.m b/internal/frontend/desktop/darwin/WailsSidebar.m
new file mode 100644
index 0000000..1ee5611
--- /dev/null
+++ b/internal/frontend/desktop/darwin/WailsSidebar.m
@@ -0,0 +1,517 @@
+//
+//  WailsSidebar.m
+//
+
+#import "WailsSidebar.h"
+#import "WailsContext.h"
+
+static const CGFloat WailsSidebarDefaultWidth = 250.0;
+static const CGFloat WailsSidebarDefaultInset = 8.0;
+static const CGFloat WailsSidebarDefaultCornerRadius = 14.0;
+static const CGFloat WailsSidebarDefaultTopInset = 44.0;
+static const CGFloat WailsSidebarDefaultTrafficLightX = 22.0;
+static const CGFloat WailsSidebarDefaultTrafficLightY = 26.0;
+static const CGFloat WailsSidebarItemHeight = 28.0;
+static const CGFloat WailsSidebarGroupHeight = 34.0;
+
+// Apple's window and panel shapes are squircles, not plain rounded rectangles.
+// The continuous curve is set through KVC so this file does not have to link
+// QuartzCore just to reference kCACornerCurveContinuous.
+static void WailsSidebarRoundCorners(CALayer *layer, CGFloat radius) {
+    if (layer == nil) {
+        return;
+    }
+    [layer setCornerRadius:radius];
+    [layer setMasksToBounds:YES];
+    if ([layer respondsToSelector:@selector(setCornerCurve:)]) {
+        [layer setValue:@"continuous" forKey:@"cornerCurve"];
+    }
+}
+
+// Liquid Glass on macOS 26, sidebar vibrancy everywhere else. Looked up by
+// name so the file still compiles against older SDKs.
+static NSView* WailsSidebarMakeBackdrop(NSRect frame, BOOL allowGlass) {
+    if (allowGlass) {
+        Class glassClass = NSClassFromString(@"NSGlassEffectView");
+        if (glassClass != nil) {
+            NSView *glass = [[[glassClass alloc] initWithFrame:frame] autorelease];
+            [glass setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+            return glass;
+        }
+    }
+    NSVisualEffectView *effect =
+        [[[NSVisualEffectView alloc] initWithFrame:frame] autorelease];
+    [effect setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+    [effect setMaterial:NSVisualEffectMaterialSidebar];
+    [effect setBlendingMode:NSVisualEffectBlendingModeWithinWindow];
+    [effect setState:NSVisualEffectStateFollowsWindowActiveState];
+    return effect;
+}
+
+@interface WailsSidebar ()
+- (void) applyMetrics;
+- (void) applyWindowCornerRadius:(CGFloat)radius;
+- (void) layoutTrafficLights;
+- (void) windowGeometryChanged:(NSNotification *)notification;
+- (void) replaceBackdropAllowingGlass:(BOOL)allowGlass;
+- (NSColor*) colorFromHex:(NSString*)hex;
+- (void) selectItemWithID:(NSString*)itemID notify:(bool)notify;
+- (NSDictionary*) entryAtRow:(NSInteger)row;
+@end
+
+@implementation WailsSidebar
+
+@synthesize context;
+@synthesize backdrop;
+@synthesize scrollView;
+@synthesize tableView;
+@synthesize items;
+@synthesize panelWidth;
+@synthesize inset;
+@synthesize cornerRadius;
+@synthesize topInset;
+@synthesize trafficLightX;
+@synthesize trafficLightY;
+@synthesize placeTrafficLights;
+@synthesize suppressSelectionEvent;
+
++ (WailsSidebar*) attachTo:(WailsContext*)ctx {
+    NSView *contentView = [ctx.mainWindow contentView];
+    NSRect contentBounds = [contentView bounds];
+
+    NSRect sidebarFrame = NSMakeRect(
+        WailsSidebarDefaultInset,
+        WailsSidebarDefaultInset,
+        WailsSidebarDefaultWidth,
+        contentBounds.size.height - (WailsSidebarDefaultInset * 2)
+    );
+    WailsSidebar *sidebar = [[[WailsSidebar alloc] initWithFrame:sidebarFrame] autorelease];
+    sidebar.context = ctx;
+    sidebar.items = [NSArray array];
+    sidebar.panelWidth = WailsSidebarDefaultWidth;
+    sidebar.inset = WailsSidebarDefaultInset;
+    sidebar.cornerRadius = WailsSidebarDefaultCornerRadius;
+    sidebar.topInset = WailsSidebarDefaultTopInset;
+    sidebar.trafficLightX = WailsSidebarDefaultTrafficLightX;
+    sidebar.trafficLightY = WailsSidebarDefaultTrafficLightY;
+    sidebar.placeTrafficLights = false;
+    sidebar.suppressSelectionEvent = false;
+    // Fixed margins top and bottom keep it floating as the window resizes.
+    [sidebar setAutoresizingMask:NSViewHeightSizable | NSViewMaxXMargin];
+    [sidebar setWantsLayer:YES];
+
+    [sidebar replaceBackdropAllowingGlass:YES];
+
+    NSRect scrollFrame = NSMakeRect(
+        0, 0, WailsSidebarDefaultWidth,
+        sidebarFrame.size.height - WailsSidebarDefaultTopInset
+    );
+    NSScrollView *scroller = [[[NSScrollView alloc] initWithFrame:scrollFrame] autorelease];
+    [scroller setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+    [scroller setDrawsBackground:NO];
+    [scroller setHasVerticalScroller:YES];
+    [scroller setAutohidesScrollers:YES];
+    [scroller setBorderType:NSNoBorder];
+    [scroller setAutomaticallyAdjustsContentInsets:NO];
+    [scroller setContentInsets:NSEdgeInsetsMake(0, 0, 8, 0)];
+    [scroller setScrollerInsets:NSEdgeInsetsMake(0, 0, 0, 4)];
+    sidebar.scrollView = scroller;
+
+    NSTableView *table = [[[NSTableView alloc] initWithFrame:NSZeroRect] autorelease];
+    NSTableColumn *column = [[[NSTableColumn alloc] initWithIdentifier:@"wails.sidebar.item"] autorelease];
+    [column setResizingMask:NSTableColumnAutoresizingMask];
+    [table addTableColumn:column];
+    [table setHeaderView:nil];
+    [table setBackgroundColor:[NSColor clearColor]];
+    [table setFocusRingType:NSFocusRingTypeNone];
+    [table setAllowsEmptySelection:YES];
+    [table setAllowsMultipleSelection:NO];
+    [table setFloatsGroupRows:NO];
+    [table setIntercellSpacing:NSMakeSize(0, 2)];
+    [table setSelectionHighlightStyle:NSTableViewSelectionHighlightStyleSourceList];
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 110000
+    if (@available(macOS 11.0, *)) {
+        [table setStyle:NSTableViewStyleSourceList];
+    }
+#endif
+    [table setDataSource:sidebar];
+    [table setDelegate:sidebar];
+    sidebar.tableView = table;
+
+    [scroller setDocumentView:table];
+    [sidebar addSubview:scroller];
+    [sidebar applyMetrics];
+
+    // Layered above the webview so the vibrancy samples the page beneath it.
+    [contentView addSubview:sidebar positioned:NSWindowAbove relativeTo:nil];
+
+    // AppKit re-lays the traffic lights out on resize, so re-apply after it.
+    [[NSNotificationCenter defaultCenter] addObserver:sidebar
+                                             selector:@selector(windowGeometryChanged:)
+                                                 name:NSWindowDidResizeNotification
+                                               object:ctx.mainWindow];
+
+    return sidebar;
+}
+
+- (void) dealloc {
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+    [self.backdrop release];
+    [self.scrollView release];
+    [self.tableView release];
+    [self.items release];
+    [super dealloc];
+}
+
+// Lets the window be dragged by the empty strip that holds the traffic lights.
+- (BOOL) mouseDownCanMoveWindow {
+    return YES;
+}
+
+- (void) viewDidMoveToWindow {
+    [super viewDidMoveToWindow];
+    [self applyMetrics];
+}
+
+- (void) windowGeometryChanged:(NSNotification *)notification {
+    [self layoutTrafficLights];
+}
+
+- (void) replaceBackdropAllowingGlass:(BOOL)allowGlass {
+    if (self.backdrop != nil) {
+        [self.backdrop removeFromSuperview];
+        self.backdrop = nil;
+    }
+    NSView *view = WailsSidebarMakeBackdrop([self bounds], allowGlass);
+    self.backdrop = view;
+    [self addSubview:view positioned:NSWindowBelow relativeTo:nil];
+}
+
+- (void) applyMetrics {
+    NSView *parent = [self superview];
+    if (parent != nil) {
+        NSRect parentBounds = [parent bounds];
+        CGFloat panelHeight = parentBounds.size.height - (self.inset * 2);
+        if (panelHeight < 0) {
+            panelHeight = 0;
+        }
+        [self setFrame:NSMakeRect(self.inset, self.inset, self.panelWidth, panelHeight)];
+    }
+
+    // Rounded, bordered panel floating over the webview.
+    [self setWantsLayer:YES];
+    CALayer *layer = [self layer];
+    WailsSidebarRoundCorners(layer, self.cornerRadius);
+    [layer setBorderWidth:1.0];
+    [layer setBorderColor:[[NSColor colorWithWhite:1.0 alpha:0.12] CGColor]];
+
+    [self.backdrop setFrame:[self bounds]];
+
+    NSRect bounds = [self bounds];
+    CGFloat height = bounds.size.height - self.topInset;
+    if (height < 0) {
+        height = 0;
+    }
+    [self.scrollView setFrame:NSMakeRect(0, 0, bounds.size.width, height)];
+
+    [self layoutTrafficLights];
+}
+
+// The window keeps a hidden title bar with no toolbar, which avoids the
+// toolbar's own glass backing showing through the panel. Without a toolbar the
+// traffic lights sit high in the corner, so they are placed by hand instead.
+- (void) layoutTrafficLights {
+    if (!self.placeTrafficLights) {
+        return;
+    }
+    NSWindow *window = [self window];
+    if (window == nil) {
+        return;
+    }
+    NSButton *close = [window standardWindowButton:NSWindowCloseButton];
+    NSButton *minimise = [window standardWindowButton:NSWindowMiniaturizeButton];
+    NSButton *zoom = [window standardWindowButton:NSWindowZoomButton];
+    if (close == nil || minimise == nil || zoom == nil) {
+        return;
+    }
+    NSView *container = [close superview];
+    if (container == nil) {
+        return;
+    }
+
+    CGFloat spacing = NSMinX([minimise frame]) - NSMinX([close frame]);
+    if (spacing <= 0) {
+        spacing = 20.0;
+    }
+    NSRect closeFrame = [close frame];
+    CGFloat containerHeight = NSHeight([container bounds]);
+    CGFloat top = containerHeight - self.trafficLightY - NSHeight(closeFrame);
+    // Outside the container the buttons still draw but stop hit-testing.
+    if (top < 0) {
+        top = 0;
+    }
+    if (top > containerHeight - NSHeight(closeFrame)) {
+        top = containerHeight - NSHeight(closeFrame);
+    }
+
+    closeFrame.origin = NSMakePoint(self.trafficLightX, top);
+    [close setFrame:closeFrame];
+
+    NSRect minimiseFrame = [minimise frame];
+    minimiseFrame.origin = NSMakePoint(self.trafficLightX + spacing, top);
+    [minimise setFrame:minimiseFrame];
+
+    NSRect zoomFrame = [zoom frame];
+    zoomFrame.origin = NSMakePoint(self.trafficLightX + (spacing * 2), top);
+    [zoom setFrame:zoomFrame];
+}
+
+// macOS clips a titled window to its own corner radius, which is tighter than
+// the Tahoe toolbar-window shape Apple's media apps use. Rounding the content
+// view and letting the window draw clear behind it gives the larger continuous
+// radius without losing the traffic lights or the system shadow.
+- (void) applyWindowCornerRadius:(CGFloat)radius {
+    NSWindow *window = [self window];
+    if (window == nil || radius <= 0) {
+        return;
+    }
+    NSView *content = [window contentView];
+    if (content == nil) {
+        return;
+    }
+    [window setOpaque:NO];
+    [window setBackgroundColor:[NSColor clearColor]];
+    [content setWantsLayer:YES];
+    WailsSidebarRoundCorners([content layer], radius);
+    [window invalidateShadow];
+}
+
+- (NSColor*) colorFromHex:(NSString*)hex {
+    if (hex == nil) {
+        return nil;
+    }
+    NSString *cleaned = [hex hasPrefix:@"#"] ? [hex substringFromIndex:1] : hex;
+    if ([cleaned length] != 6) {
+        return nil;
+    }
+    unsigned int value = 0;
+    NSScanner *scanner = [NSScanner scannerWithString:cleaned];
+    if (![scanner scanHexInt:&value]) {
+        return nil;
+    }
+    return [NSColor colorWithSRGBRed:((value >> 16) & 0xFF) / 255.0
+                               green:((value >> 8) & 0xFF) / 255.0
+                                blue:(value & 0xFF) / 255.0
+                               alpha:1.0];
+}
+
+- (void) configureWithJSON:(NSString*)json {
+    NSData *data = [json dataUsingEncoding:NSUTF8StringEncoding];
+    if (data == nil) {
+        return;
+    }
+    id parsed = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    if (![parsed isKindOfClass:[NSDictionary class]]) {
+        return;
+    }
+    NSDictionary *config = (NSDictionary *)parsed;
+
+    id material = [config objectForKey:@"material"];
+    if ([material isKindOfClass:[NSString class]]) {
+        [self replaceBackdropAllowingGlass:![material isEqualToString:@"vibrancy"]];
+    }
+
+    id width = [config objectForKey:@"width"];
+    if ([width isKindOfClass:[NSNumber class]]) {
+        self.panelWidth = [width doubleValue];
+    }
+
+    id panelInset = [config objectForKey:@"inset"];
+    if ([panelInset isKindOfClass:[NSNumber class]]) {
+        self.inset = [panelInset doubleValue];
+    }
+
+    id radius = [config objectForKey:@"cornerRadius"];
+    if ([radius isKindOfClass:[NSNumber class]]) {
+        self.cornerRadius = [radius doubleValue];
+    }
+
+    id top = [config objectForKey:@"topInset"];
+    if ([top isKindOfClass:[NSNumber class]]) {
+        self.topInset = [top doubleValue];
+    }
+
+    id lightX = [config objectForKey:@"trafficLightX"];
+    id lightY = [config objectForKey:@"trafficLightY"];
+    if ([lightX isKindOfClass:[NSNumber class]] &&
+        [lightY isKindOfClass:[NSNumber class]]) {
+        self.trafficLightX = [lightX doubleValue];
+        self.trafficLightY = [lightY doubleValue];
+        self.placeTrafficLights = true;
+    }
+    [self applyMetrics];
+
+    id windowRadius = [config objectForKey:@"windowCornerRadius"];
+    if ([windowRadius isKindOfClass:[NSNumber class]]) {
+        [self applyWindowCornerRadius:[windowRadius doubleValue]];
+    }
+
+    id newItems = [config objectForKey:@"items"];
+    if ([newItems isKindOfClass:[NSArray class]]) {
+        self.items = newItems;
+        [self.tableView reloadData];
+    }
+
+    id selected = [config objectForKey:@"selected"];
+    if ([selected isKindOfClass:[NSString class]]) {
+        [self selectItemWithID:(NSString *)selected notify:false];
+    }
+
+    // Lets the page confirm a real native sidebar exists before it hides its
+    // own HTML one. Builds without this patch never fire it.
+    [self.context ExecJS:@"window.wailsNativeSidebar = true;"
+        "window.dispatchEvent(new CustomEvent('wails:sidebar-ready'));"];
+}
+
+- (void) selectItemWithID:(NSString*)itemID notify:(bool)notify {
+    NSUInteger count = [self.items count];
+    for (NSUInteger index = 0; index < count; index++) {
+        id entry = [self.items objectAtIndex:index];
+        if (![entry isKindOfClass:[NSDictionary class]]) {
+            continue;
+        }
+        if (![itemID isEqualToString:[(NSDictionary *)entry objectForKey:@"id"]]) {
+            continue;
+        }
+        self.suppressSelectionEvent = !notify;
+        [self.tableView selectRowIndexes:[NSIndexSet indexSetWithIndex:index]
+                    byExtendingSelection:NO];
+        [self.tableView scrollRowToVisible:index];
+        self.suppressSelectionEvent = false;
+        return;
+    }
+}
+
+- (NSDictionary*) entryAtRow:(NSInteger)row {
+    if (row < 0 || row >= (NSInteger)[self.items count]) {
+        return nil;
+    }
+    id entry = [self.items objectAtIndex:row];
+    if (![entry isKindOfClass:[NSDictionary class]]) {
+        return nil;
+    }
+    return (NSDictionary *)entry;
+}
+
+/***** NSTableViewDataSource *****/
+
+- (NSInteger) numberOfRowsInTableView:(NSTableView *)table {
+    return (NSInteger)[self.items count];
+}
+
+/***** NSTableViewDelegate *****/
+
+- (BOOL) tableView:(NSTableView *)table isGroupRow:(NSInteger)row {
+    NSDictionary *entry = [self entryAtRow:row];
+    return entry != nil && [entry objectForKey:@"group"] != nil;
+}
+
+- (BOOL) tableView:(NSTableView *)table shouldSelectRow:(NSInteger)row {
+    NSDictionary *entry = [self entryAtRow:row];
+    return entry != nil && [entry objectForKey:@"group"] == nil;
+}
+
+- (CGFloat) tableView:(NSTableView *)table heightOfRow:(NSInteger)row {
+    return [self tableView:table isGroupRow:row] ? WailsSidebarGroupHeight : WailsSidebarItemHeight;
+}
+
+- (NSView *) tableView:(NSTableView *)table
+    viewForTableColumn:(NSTableColumn *)column
+                   row:(NSInteger)row {
+    NSDictionary *entry = [self entryAtRow:row];
+    if (entry == nil) {
+        return nil;
+    }
+    BOOL isGroup = [entry objectForKey:@"group"] != nil;
+    CGFloat width = [self bounds].size.width;
+
+    if (isGroup) {
+        NSTextField *label = [NSTextField labelWithString:@""];
+        [label setFrame:NSMakeRect(10, 4, width - 20, 18)];
+        [label setAutoresizingMask:NSViewWidthSizable];
+        [label setFont:[NSFont systemFontOfSize:11 weight:NSFontWeightBold]];
+        [label setTextColor:[NSColor secondaryLabelColor]];
+        [label setStringValue:[entry objectForKey:@"group"]];
+
+        NSTableCellView *cell = [[[NSTableCellView alloc]
+            initWithFrame:NSMakeRect(0, 0, width, WailsSidebarGroupHeight)] autorelease];
+        [cell setAutoresizingMask:NSViewWidthSizable];
+        [cell addSubview:label];
+        [cell setTextField:label];
+        return cell;
+    }
+
+    NSTableCellView *cell = [[[NSTableCellView alloc]
+        initWithFrame:NSMakeRect(0, 0, width, WailsSidebarItemHeight)] autorelease];
+    [cell setAutoresizingMask:NSViewWidthSizable];
+
+    NSImageView *icon = [[[NSImageView alloc] initWithFrame:NSMakeRect(8, 5, 18, 18)] autorelease];
+    [icon setImageScaling:NSImageScaleProportionallyDown];
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 110000
+    id symbol = [entry objectForKey:@"symbol"];
+    if ([symbol isKindOfClass:[NSString class]]) {
+        if (@available(macOS 11.0, *)) {
+            NSImage *image = [NSImage imageWithSystemSymbolName:(NSString *)symbol
+                                      accessibilityDescription:nil];
+            [icon setImage:image];
+        }
+    }
+#endif
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 101400
+    if (@available(macOS 10.14, *)) {
+        NSColor *tint = [self colorFromHex:[entry objectForKey:@"tint"]];
+        [icon setContentTintColor:tint != nil ? tint : [NSColor controlAccentColor]];
+    }
+#endif
+    [cell addSubview:icon];
+    [cell setImageView:icon];
+
+    NSTextField *label = [NSTextField labelWithString:@""];
+    [label setFrame:NSMakeRect(34, 5, width - 44, 18)];
+    [label setAutoresizingMask:NSViewWidthSizable];
+    [label setFont:[NSFont systemFontOfSize:13]];
+    [label setTextColor:[NSColor labelColor]];
+    [label setLineBreakMode:NSLineBreakByTruncatingTail];
+    id title = [entry objectForKey:@"title"];
+    [label setStringValue:[title isKindOfClass:[NSString class]] ? (NSString *)title : @""];
+    [cell addSubview:label];
+    [cell setTextField:label];
+
+    return cell;
+}
+
+- (void) tableViewSelectionDidChange:(NSNotification *)notification {
+    if (self.suppressSelectionEvent) {
+        return;
+    }
+    NSDictionary *entry = [self entryAtRow:[self.tableView selectedRow]];
+    if (entry == nil) {
+        return;
+    }
+    id itemID = [entry objectForKey:@"id"];
+    if (![itemID isKindOfClass:[NSString class]]) {
+        return;
+    }
+    NSDictionary *detail = [NSDictionary dictionaryWithObject:itemID forKey:@"id"];
+    NSData *payload = [NSJSONSerialization dataWithJSONObject:detail options:0 error:nil];
+    if (payload == nil) {
+        return;
+    }
