<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root menu for Petbox.

  The Pets entry is a pipe menu: Openbox runs `petctl menu` every time the menu
  is opened and gets the current pen back as XML. That is why making a pet
  never has to regenerate this file - a pet born a second ago is already in the
  menu.

  Everything below the pen is the desktop base's neutral menu, kept in the same
  order so the substrate stays recognisable across products.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Petbox">
    <item label="New Pet...">
      <action name="Execute">
        <command>kitty --title "New Pet" -e petctl new</command>
      </action>
    </item>
    <menu id="pets-menu" label="Pets" execute="petctl menu" />
    <separator />
    <menu id="pen-menu" label="The Pen">
      <item label="Welcome">
        <action name="Execute">
          <command>desktop-welcome</command>
        </action>
      </item>
      <item label="Status">
        <action name="Execute">
          <command>kitty --title "Pen" -e bash -lc "petctl status; petctl list; read -n 1 -s -r"</command>
        </action>
      </item>
      <separator />
      <item label="Pause Thinking">
        <action name="Execute">
          <command>petctl pause</command>
        </action>
      </item>
      <item label="Resume Thinking">
        <action name="Execute">
          <command>petctl pause --off</command>
        </action>
      </item>
      <item label="Restart Supervisor">
        <action name="Execute">
          <command>petctl restart</command>
        </action>
      </item>
      <separator />
      <item label="Pen Files">
        <action name="Execute">
          <command>kitty -e ranger /workspace/pets</command>
        </action>
      </item>
      <item label="Supervisor Log">
        <action name="Execute">
          <command>kitty --title "petd" -e less +F /var/log/launcher-desktop/pets.log</command>
        </action>
      </item>
    </menu>
    <menu id="codex-menu" label="Codex">
      <item label="Codex">
        <action name="Execute">
          <command>desktop-harness</command>
        </action>
      </item>
      <item label="Sign In">
        <action name="Execute">
          <command>kitty --title "Codex sign-in" -e bash -lc "codex-setup; read -n 1 -s -r"</command>
        </action>
      </item>
      <item label="Check Everything">
        <action name="Execute">
          <command>kitty --title "petctl doctor" -e bash -lc "petctl doctor; read -n 1 -s -r"</command>
        </action>
      </item>
    </menu>
    <separator />
    <item label="Terminal">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </item>
    <separator />
    <item label="File Manager">
      <action name="Execute">
        <command>kitty -e ranger /workspace</command>
      </action>
    </item>
    <item label="Task Manager">
      <action name="Execute">
        <command>kitty -e htop</command>
      </action>
    </item>
    <separator />
    <item label="Browser">
      <action name="Execute">
        <command>chromium file:///opt/browser/index.html</command>
      </action>
    </item>
    <separator />
    <menu id="tiling-menu" label="Tiling Mode">
      <item label="Enable Tiling">
        <action name="Execute">
          <command>cortilectl on</command>
        </action>
      </item>
      <item label="Disable Tiling (Floating)">
        <action name="Execute">
          <command>cortilectl off</command>
        </action>
      </item>
      <item label="Toggle Tiling">
        <action name="Execute">
          <command>cortilectl toggle</command>
        </action>
      </item>
      <separator />
      <item label="Next Layout">
        <action name="Execute">
          <command>cortilectl next-layout</command>
        </action>
      </item>
      <item label="Previous Layout">
        <action name="Execute">
          <command>cortilectl prev-layout</command>
        </action>
      </item>
      <separator />
      <item label="Stop Tiling Helper">
        <action name="Execute">
          <command>cortilectl stop</command>
        </action>
      </item>
      <item label="Start Tiling Helper">
        <action name="Execute">
          <command>cortilectl start</command>
        </action>
      </item>
    </menu>
  </menu>
</openbox_menu>
