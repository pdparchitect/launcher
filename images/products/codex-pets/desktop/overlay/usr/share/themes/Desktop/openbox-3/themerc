### WINDOW
# Two pixels, not one. Everything else on this desktop is drawn on a 4x pixel
# grid, and a one-pixel frame is the only line on screen thin enough to look
# like an accident.
border.width: 2

# Grab margin. Openbox has no separate resize-sensitivity setting: the areas
# you can grab are exactly the areas it draws. Client padding inserts frame
# around the client and paints it in the frame background, so the visible
# border stays 2px while the grabbable ring around the window is wider.
window.client.padding.width: 8
window.client.padding.height: 4
window.handle.width: 0

padding.width: 10
padding.height: 6

# The pen is dark and so is every window frame. Outline the focused window in
# gold so exactly one window reads as active, and leave the rest to recede into
# the wallpaper - which is where the pets are.
window.active.border.color: #F5C542
window.inactive.border.color: #0A0B1A
window.active.title.separator.color: #0A0B1A
window.inactive.title.separator.color: #0A0B1A
window.active.client.color: #0A0B1A
window.inactive.client.color: #0A0B1A

window.active.label.text.color: #FFE9A8
window.inactive.label.text.color: #7C84B8

window.active.button.unpressed.image.color: #FFE9A8
window.active.button.pressed.image.color: #F5C542
window.active.button.disabled.image.color: #1E2150
window.active.button.hover.image.color: #FFDE7A
window.active.button.toggled.unpressed.image.color: #FFE9A8
window.active.button.toggled.pressed.image.color: #F5C542
window.active.button.toggled.hover.image.color: #FFDE7A
window.inactive.button.unpressed.image.color: #4A5080
window.inactive.button.pressed.image.color: #F5C542
window.inactive.button.disabled.image.color: #121434
window.inactive.button.hover.image.color: #FFDE7A
window.inactive.button.toggled.unpressed.image.color: #4A5080
window.inactive.button.toggled.pressed.image.color: #F5C542
window.inactive.button.toggled.hover.image.color: #FFDE7A

window.active.title.bg: flat solid
window.active.title.bg.color: #1E2150
window.active.label.bg: flat solid
window.active.label.bg.color: #1E2150
window.active.handle.bg: flat solid
window.active.handle.bg.color: #1E2150
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1E2150
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #121434
window.inactive.label.bg: flat solid
window.inactive.label.bg.color: #121434
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #121434
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #121434

window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.pressed.bg: parentrelative
window.active.button.toggled.hover.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.pressed.bg: parentrelative
window.inactive.button.toggled.hover.bg: parentrelative

# Left, not centred. A title that starts where the window starts reads like a
# label on a cartridge rather than a caption.
window.label.text.justify: left

