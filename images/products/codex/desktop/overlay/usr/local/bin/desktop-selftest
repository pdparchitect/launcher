#!/bin/bash
# desktop-selftest - product assertions run by the shared live smoke test.

set -uo pipefail

failures=0

check() {
    local label="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        echo "  ok   $label"
    else
        echo "  FAIL $label" >&2
        failures=$((failures + 1))
    fi
}

echo "codex selftest"

check "Codex runs" codex --version
check "the state directory is writable" test -w "${CODEX_HOME:-$HOME/.codex}"
# Codex resolves its home from CODEX_HOME. If that ever stops naming the
# declared volume, a signed-in session is lost on the next start instead.
check "the state directory is the declared volume" \
    test "${CODEX_HOME:-}" = /home/agent/.codex
check "the workspace is writable" test -w /workspace

if [ "$failures" -gt 0 ]; then
    echo "codex selftest: $failures failed" >&2
    exit 1
fi

echo "codex selftest: Codex is ready"
