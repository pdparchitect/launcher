### WINDOW
border.width: 1

# Grab margin. Openbox has no separate resize-sensitivity setting: the areas
# you can grab are exactly the areas it draws. Client padding is the one knob
# that adds frame without widening the visible border - it inserts frame around
# the client and paints it in the frame background, so the white focus outline
# stays 1px while the grabbable ring around the window goes from 1px to 7px.
# Measured via _NET_FRAME_EXTENTS: 1,1,28,1 at 0 becomes 7,7,34,7 at 6.
window.client.padding.width: 12
window.client.padding.height: 6
# No bottom handle. It renders as a second line under the client area with a
# resize grip boxed off at each end, which reads as clutter now that the frame
# itself is outlined. Resizing stays available through the window edges and
# corners and through Alt+right-drag anywhere on the frame (see rc.xml).
window.handle.width: 0

# Openbox has no menu-only padding: these globals inset menu item text and
# pad the titlebar. Raised from 6/5 to give the menu room inside its 1px
# border, which also takes the titlebar from 27px to 33px.
padding.width: 12
padding.height: 8

# Every window frame is the same deep blue as the panel, so an unmarked window
# has no visible edge against the wallpaper. Outline the focused window in the
# accent; unfocused frames stay dark so exactly one window reads as active.
window.active.border.color: #3B6FE8
window.inactive.border.color: #050F42
window.active.title.separator.color: #050F42
window.inactive.title.separator.color: #050F42
