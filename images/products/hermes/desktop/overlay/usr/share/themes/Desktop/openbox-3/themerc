window.active.button.pressed.image.color: #3B6FE8
window.active.button.disabled.image.color: #081A66
window.active.button.hover.image.color: #86A9F5
window.active.button.toggled.unpressed.image.color: #DCE6FB
window.active.button.toggled.pressed.image.color: #3B6FE8
window.active.button.toggled.hover.image.color: #86A9F5
window.inactive.button.unpressed.image.color: #3A4E8C
window.inactive.button.pressed.image.color: #3B6FE8
window.inactive.button.disabled.image.color: #081A66
window.inactive.button.hover.image.color: #86A9F5
