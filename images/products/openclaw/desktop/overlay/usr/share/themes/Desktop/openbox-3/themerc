menu.separator.width: 1
menu.separator.padding.width: 12
menu.separator.padding.height: 4

menu.overlap.x: 0
menu.overlap.y: 0

menu.border.color: #F5654A
menu.separator.color: #4A151C

menu.title.text.color: #EDEDED
menu.items.text.color: #BCBCC4
menu.items.disabled.text.color: #865E64
menu.items.active.text.color: #25080D
menu.items.active.disabled.text.color: #75434A

menu.items.bg: flat solid
menu.items.bg.color: #25080D
menu.items.active.bg: flat solid
menu.items.active.bg.color: #F5654A
menu.title.bg: flat solid
menu.title.bg.color: #3B1015

menu.title.text.justify: center

#menu.items.font: text shadow
#menu.title.text.font: text shadow

