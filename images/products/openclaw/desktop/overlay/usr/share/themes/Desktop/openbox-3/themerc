### WINDOW
border.width: 1

# Keep the client flush with the frame. Padding here is painted in
# window.*.client.color, which showed up as a black gap around Kitty.
window.client.padding.width: 0
window.client.padding.height: 0
# No bottom handle. It renders as a second line under the client area with a
# resize grip boxed off at each end, which reads as clutter now that the frame
# itself is outlined. Resizing stays available through the window edges and
# corners and through Alt+right-drag anywhere on the frame (see rc.xml).
window.handle.width: 0

# Openbox has no menu-only padding: these globals inset menu item text and
# pad the titlebar. Raised from 6/5 to give the menu room inside its 1px
# border, which also takes the titlebar from 27px to 33px.
padding.width: 12
padding.height: 8

# Every window frame is the same ink as the panel, so an unmarked window
# has no visible edge against the wallpaper. Outline the focused window in the
# accent; unfocused frames stay dark so exactly one window reads as active.
window.active.border.color: #F5654A
window.inactive.border.color: #101012
window.active.title.separator.color: #3B1015
window.inactive.title.separator.color: #25080D
window.active.client.color: #101012
window.inactive.client.color: #101012

window.active.label.text.color: #EDEDED
window.inactive.label.text.color: #9A9AA2

window.active.button.unpressed.image.color: #EDEDED
window.active.button.pressed.image.color: #F5654A
window.active.button.disabled.image.color: #19191C
window.active.button.hover.image.color: #4FC8AE
window.active.button.toggled.unpressed.image.color: #EDEDED
window.active.button.toggled.pressed.image.color: #F5654A
window.active.button.toggled.hover.image.color: #4FC8AE
window.inactive.button.unpressed.image.color: #45454C
window.inactive.button.pressed.image.color: #F5654A
window.inactive.button.disabled.image.color: #19191C
window.inactive.button.hover.image.color: #4FC8AE
window.inactive.button.toggled.unpressed.image.color: #45454C
window.inactive.button.toggled.pressed.image.color: #F5654A
window.inactive.button.toggled.hover.image.color: #4FC8AE

window.active.title.bg: flat solid
window.active.title.bg.color: #3B1015
window.active.label.bg: flat solid
window.active.label.bg.color: #3B1015
window.active.handle.bg: flat solid
window.active.handle.bg.color: #3B1015
window.active.grip.bg: flat solid
window.active.grip.bg.color: #3B1015
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #25080D
window.inactive.label.bg: flat solid
window.inactive.label.bg.color: #25080D
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #25080D
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #25080D

window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.active.button.disabled.bg: parentrelative
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.pressed.bg: parentrelative
window.active.button.toggled.hover.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.pressed.bg: parentrelative
window.inactive.button.toggled.hover.bg: parentrelative

window.label.text.justify: center

#window.active.label.text.font: text shadow
#window.inactive.label.text.font: text shadow

### MENU
