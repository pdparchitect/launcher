{
  "schemaVersion": 2,
  "id": "c68ea001-a382-402e-9ae4-cc314a740fd4",
  "slug": "opencode",
  "name": "OpenCode",
  "publisher": "Anomaly",
  "description": "A persistent browser desktop for OpenCode, the open source coding agent, with its terminal interface, providers, agents, tools, and workspace.",
  "tags": [
    "DEVELOPMENT",
    "ASSISTANT",
    "TERMINAL"
  ],
  "media": {
    "icon": "icon.svg",
    "cover": "screenshot.jpg",
    "screenshots": [
      {
        "source": "screenshot.jpg",
        "alt": "OpenCode running in its persistent, branded browser terminal"
      }
    ]
  },
  "interfaces": {
    "desktop": {
      "kind": "kasmweb",
      "port": 6901,
      "path": "/"
    },
    "health": {
      "kind": "health",
      "port": 6902,
      "path": "/healthz"
    },
    "notifications": {
      "kind": "notifications",
      "port": 6902,
      "path": "/notifications"
    },
    "preview": {
      "kind": "preview",
      "port": 6902,
      "path": "/preview.jpg"
    }
  },
  "memory": "4g",
  "sharedMemory": "1g",
  "environment": {},
  "mounts": [
    {
      "name": "workspace",
      "target": "/workspace"
    },
    {
      "name": "private/opencode",
      "target": "/home/agent/.opencode"
    }
  ]
}
