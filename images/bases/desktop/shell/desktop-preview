#!/usr/bin/env python3

import http.server
import os
import pathlib
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from http import HTTPStatus


DISPLAY = os.environ.get("DISPLAY", ":1")
PORT = 6902
CACHE_SECONDS = float(os.environ.get("DESKTOP_PREVIEW_CACHE_SECONDS", "2"))
MAX_BYTES = 4 * 1024 * 1024
CACHE_DIRECTORY = pathlib.Path("/tmp/launcher-desktop-preview")
CACHE_PATH = CACHE_DIRECTORY / "preview.jpg"
capture_lock = threading.Lock()


def capture_preview() -> bytes:
    with capture_lock:
        try:
            age = time.time() - CACHE_PATH.stat().st_mtime
            if age <= CACHE_SECONDS and CACHE_PATH.stat().st_size > 0:
                return CACHE_PATH.read_bytes()
        except FileNotFoundError:
            pass

        CACHE_DIRECTORY.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix="preview-",
            suffix=".jpg",
            dir=CACHE_DIRECTORY,
        )
        os.close(descriptor)
        temporary_path = pathlib.Path(temporary_name)
        environment = os.environ.copy()
        environment["DISPLAY"] = DISPLAY

        try:
            result = subprocess.run(
                [
                    "scrot",
                    "--silent",
                    "--overwrite",
                    "--quality",
                    "65",
                    str(temporary_path),
                ],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                env=environment,
                timeout=5,
            )
            if result.returncode != 0:
                message = result.stderr.decode("utf-8", errors="replace").strip()
                raise RuntimeError(message or "screen capture failed")
            size = temporary_path.stat().st_size
            if size < 1 or size > MAX_BYTES:
                raise RuntimeError(f"snapshot size {size} is outside allowed range")
            temporary_path.replace(CACHE_PATH)
            return CACHE_PATH.read_bytes()
        finally:
            temporary_path.unlink(missing_ok=True)


class PreviewHandler(http.server.BaseHTTPRequestHandler):
    server_version = "LauncherDesktopPreview/0.1"

    def do_GET(self) -> None:
        path = urllib.parse.urlsplit(self.path).path
        if path == "/healthz":
            self.send_response(HTTPStatus.NO_CONTENT)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            return
        if path != "/preview.jpg":
            self.send_error(HTTPStatus.NOT_FOUND)
            return

        try:
            snapshot = capture_preview()
        except (
            FileNotFoundError,
            OSError,
            RuntimeError,
            subprocess.TimeoutExpired,
        ) as error:
            message = f"desktop preview unavailable: {error}\n".encode()
            self.send_response(HTTPStatus.SERVICE_UNAVAILABLE)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(message)))
            self.end_headers()
            self.wfile.write(message)
            return

        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "image/jpeg")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(snapshot)))
        self.end_headers()
        self.wfile.write(snapshot)

    def log_message(self, format: str, *arguments: object) -> None:
        sys.stderr.write(
            "%s - - [%s] %s\n"
            % (
                self.client_address[0],
                self.log_date_time_string(),
                format % arguments,
            )
        )


class PreviewServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    server = PreviewServer(("0.0.0.0", PORT), PreviewHandler)
    print(
        f"[desktop-preview] serving {DISPLAY} at "
        f"http://0.0.0.0:{PORT}/preview.jpg",
        flush=True,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
