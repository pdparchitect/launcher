#!/bin/bash
# chromium - wrapper that launches the available Chromium-family browser.
# Placed in /usr/local/bin to override any system chromium and provide a
# single entry point for menus, xdg-open, kitty, and CLI tools.

# In fixed-mount mode, Xvnc and Openbox run as root with their cookie in the
# runtime directory. Chromium's subprocesses do not reliably use that
# non-default authority path, so give root-launched browsers the same cookie at
# root's default location. Unprivileged browser launches continue using the
# shared runtime file directly.
if [ "${EUID:-$(id -u)}" -eq 0 ] && [ -n "${DISPLAY:-}" ]; then
    authority_source=${XAUTHORITY:-/run/launcher-desktop/Xauthority}
    if [ -r "$authority_source" ] && [ "$authority_source" != /root/.Xauthority ]; then
        install -o root -g root -m 600 "$authority_source" /root/.Xauthority
    fi
    if [ -r /root/.Xauthority ]; then
        export XAUTHORITY=/root/.Xauthority
    fi
fi

# The session keeps HOME=/home/agent whichever account runs it: a Docker volume
# is chownable so the session runs as `agent`, while Apple's fixed-ownership
# mounts leave it on the VM root account. A browser started by the root session
# therefore writes into the agent account's home, and what it creates there
# comes out root-owned - including ".config/google-chrome/Crash Reports", which
# Chromium derives from the default profile location rather than from
# --user-data-dir. A later launch as `agent` cannot write that directory, its
# crash handler dies on the failed mkdir, and browser startup dies with it. Keep
# Chromium's per-user directories in the home of the account actually running
# it. A session already running as the owner of HOME - every Docker session, and
# any product that stays on `agent` - keeps the directories it has.
if [ -n "${HOME:-}" ] && [ ! -O "$HOME" ]; then
    own_home="$(getent passwd "$(id -u)" | cut -d: -f6)"
    if [ -n "$own_home" ] && [ "$own_home" != "$HOME" ] &&
        mkdir -p \
            "$own_home/.config" \
            "$own_home/.cache" \
            "$own_home/.local/share" 2>/dev/null; then
        export XDG_CONFIG_HOME="$own_home/.config"
        export XDG_CACHE_HOME="$own_home/.cache"
        export XDG_DATA_HOME="$own_home/.local/share"
    fi
fi

# Only use the GPU when a render node is present and this user can open it.
# With one the browser can composite and rasterize on the GPU, which removes
# the largest source of repaint work on this desktop. Without one, disable GPU
# access but retain Chromium's software rasterizer. Apple containers do not
# expose a render node, so disabling both paths can leave browser surfaces
# unpainted. A passed-through node is normally root:render 0660, so testing for
# presence alone is insufficient.
gpu_args=(--ozone-platform=x11 --disable-gpu)
for node in /dev/dri/renderD*; do
    if [ -r "$node" ] && [ -w "$node" ]; then
        gpu_args=(--ozone-platform=x11 --ignore-gpu-blocklist --enable-gpu-rasterization)
        break
    fi
done

display_args=()
if [ -n "${DISPLAY:-}" ]; then
    display_args=("--display=$DISPLAY")
fi

if [ -x /opt/google/chrome/google-chrome ]; then
    browser=/opt/google/chrome/google-chrome
elif [ -x /usr/bin/chromium ]; then
    browser=/usr/bin/chromium
else
    echo "No supported Chromium-family browser is installed." >&2
    exit 1
fi

exec "$browser" \
    "${display_args[@]}" \
    --no-sandbox \
    --test-type \
    "${gpu_args[@]}" \
    --disable-dev-shm-usage \
    --no-first-run \
    --no-default-browser-check \
    --disable-infobars \
    --force-dark-mode \
    --enable-features=WebContentsForceDark \
    "$@"
